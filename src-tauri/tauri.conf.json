{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "SUNDAY Launcher",
    "mainBinaryName":  "Sunday",
    "version": "1.8.16",
    "identifier":  "com.sadinkai.sundaylauncher",
    "build":  {
                  "frontendDist":  "../src/renderer",
                  "beforeDevCommand":  "echo dev",
                  "beforeBuildCommand":  "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-tauri-resources.ps1"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "title":  "SUNDAY Launcher",
                                    "width":  1120,
                                    "height":  740,
                                    "minWidth":  900,
                                    "minHeight":  600,
                                    "resizable":  true,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "backgroundColor":  "#00000000",
                                    "shadow":  false,
                                    "theme":  "Dark",
                                    "fullscreen":  false,
                                    "center":  true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src 'self' asset: ipc:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https://*.rbxcdn.com; font-src 'self' data:; connect-src 'self' ipc:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
                             }
            },
    "bundle":  {
                   "active":  false,
                   "targets":  [],
                   "publisher":  "SADINKAI",
                   "copyright":  "Copyright © 2026 SADINKAI",
                   "shortDescription":  "SUNDAY Launcher for Roblox account and client management",
                   "longDescription":  "SUNDAY Launcher, created by SADINKAI, manages Roblox accounts and explicit compatibility-mode client slots.",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "webviewInstallMode":  {
                                                              "type":  "skip"
                                                          }
                               }
               }
}
