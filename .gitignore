# Dependencies
node_modules/

# Build output — generated by npm run build / npm run dist / npx tauri build
dist/
build/
release-assets/
coverage/
src-tauri/target/
installer/target/

# Staged Tauri resources (auto-generated by stage-tauri-resources.ps1)
src-tauri/resources/node.exe
# Tauri's icon generator emits mobile assets even though SUNDAY targets Windows.
src-tauri/icons/android/
src-tauri/icons/ios/

# Release archives and downloaded artifacts
*.zip
*.rar
*.exe

# Logs
*.log
logs/
clones/
test/*.png
artifacts/
screenshots/
test-results/
audit-output/

# Credential and account data — NEVER commit these
.sunday-data/
accounts.json
keeper.json
settings.json
history.json
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Local environment / secrets
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
*.der
id_rsa
id_ed25519

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# IDE and editor temporary files
.vscode/settings.json
.idea/
*.suo
*.user
*.swp
*~
*.bak
*.backup
*.old
*.temp
*.orig
*.rej

# Backup directories
backups/

# Temporary / scratch files from local tooling
scratch/
*.tmp

